{
    "indentationRules": {
         "increaseIndentPattern": "^\\s*((\\bti\\b.*\\bse\\b)|(\\bbibeeko\\b.*\\bse\\b)|(\\bnigbati\\b.*\\bse\\b)|(\\bfun\\b.*\\bse\\b)|(\\bise\\b\\(.*\\)))\\s*$",
         "decreaseIndentPattern": "^\\s*(\\bpari\\b)|(\\bbibeeko\\b)\\s*$"
        
    },

    "comments": {
        "lineComment": "--"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "surroundingPairs": [
        ["\"", "\""],
        ["'", "'"]
    ]
}
