ise(fizzbuzz, n)
   fi 1 si i
   nigbati i <= n  se
        ti i % 15 == 0 se 
           pe(sope, "fizzbuzz")
        bibeeko ti i % 5 == 0 se
           pe(sope, "buzz")
        bibeeko ti i % 3 == 0 se
           pe(sope, "fizz")
        bibeeko 
           pe(sope, i)
        pari 
        i = i+  1
     pari
pari 

pe(fizzbuzz, 20)
